# Copy to .env and fill in. .env is gitignored; this file is not.

# Absolute or repo-relative path to the Google OAuth client secrets JSON
# downloaded from Google Cloud Console. Leave blank to disable the Drive
# connector — local filesystem search works without it.
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Where the Chroma vector index is persisted on disk.
VECTOR_STORE_PATH=data/index

# --- Ingestion ---------------------------------------------------------------
# Files larger than this are skipped during a scan. Default 50 MB.
MAX_FILE_SIZE_BYTES=52428800

# --- Chunking ----------------------------------------------------------------
# Target size window for a chunk, measured in tokens (not words or characters).
# NOTE: whichever embedding model Phase 2 picks has a hard input limit and
# silently truncates anything longer. all-MiniLM-L6-v2 caps at 256 tokens,
# bge-base-en-v1.5 at 512. Keep CHUNK_MAX_TOKENS at or under that limit.
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800

# Fraction of a chunk repeated at the start of the next one, so a sentence
# split across a boundary still survives whole in at least one chunk.
CHUNK_OVERLAP_RATIO=0.15
