# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Mode --------------------------------------------------------------------
# "demo"     - search the sample documents bundled with the app. The only
#              working mode.
# "personal" - recognised but NOT implemented. Setting it makes the app refuse
#              to start, explaining that a future release will let you connect
#              your own cloud drives (Google Drive, OneDrive) instead.
APP_MODE=demo

# Folder holding the bundled demo corpus. These files ship with the repo.
SAMPLE_DOCS_PATH=data/sample_docs

# --- Embeddings --------------------------------------------------------------
# Downloaded from Hugging Face on first index build (~440 MB) and cached under
# ~/.cache/huggingface. Accepts 512 tokens, produces 768-dimension vectors.
# Changing this means rebuilding the index: vector dimensions must match.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Chunks encoded per forward pass. Larger is faster but uses more memory.
EMBEDDING_BATCH_SIZE=32

# Where the Chroma vector index and the BM25 index are persisted on disk.
VECTOR_STORE_PATH=data/index

# --- Ingestion ---------------------------------------------------------------
# Files larger than this are skipped during a scan. Default 50 MB.
MAX_FILE_SIZE_BYTES=52428800

# --- Chunking ----------------------------------------------------------------
# Target size window for a chunk, measured in tokens (not words or characters).
# The embedding model has a hard input limit and silently truncates anything
# longer, so CHUNK_MAX_TOKENS must stay under it: bge-base-en-v1.5 caps at 512,
# and 480 leaves room for the special tokens it adds. Exceeding the limit is
# refused at index time rather than being discovered as missing text later.
CHUNK_MIN_TOKENS=350
CHUNK_MAX_TOKENS=480

# Fraction of a chunk repeated at the start of the next one, so a sentence
# split across a boundary still survives whole in at least one chunk.
CHUNK_OVERLAP_RATIO=0.15
